{
  "$id": "saacs.biochain.v0.Specimen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^(collectionId)$": {
      "minLength": 1,
      "type": "string"
    },
    "^(lastModified)$": {
      "$ref": "saacs.common.v0.StateActivity.schema.json"
    },
    "^(specimenId)$": {
      "minLength": 1,
      "type": "string"
    }
  },
  "properties": {
    "collection_id": {
      "minLength": 1,
      "type": "string"
    },
    "georeference": {
      "$ref": "saacs.biochain.v0.Specimen.Georeference.schema.json"
    },
    "grants": {
      "additionalProperties": {
        "$ref": "saacs.biochain.v0.Specimen.Grant.schema.json"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "images": {
      "additionalProperties": {
        "$ref": "saacs.biochain.v0.Specimen.Image.schema.json"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "last_modified": {
      "$ref": "saacs.common.v0.StateActivity.schema.json"
    },
    "loans": {
      "additionalProperties": {
        "$ref": "saacs.biochain.v0.Specimen.Loan.schema.json"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "primary": {
      "$ref": "saacs.biochain.v0.Specimen.Primary.schema.json"
    },
    "secondary": {
      "$ref": "saacs.biochain.v0.Specimen.Secondary.schema.json"
    },
    "specimen_id": {
      "minLength": 1,
      "type": "string"
    },
    "taxon": {
      "$ref": "saacs.biochain.v0.Specimen.Taxon.schema.json"
    }
  },
  "required": [
    "primary",
    "secondary",
    "taxon",
    "georeference"
  ],
  "title": "Specimen",
  "type": "object"
}
