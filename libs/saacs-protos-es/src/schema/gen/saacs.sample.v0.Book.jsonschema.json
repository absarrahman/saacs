      "type": "string"
    },
    "bookTitle": {
      "type": "string"
    },
    "collectionId": {
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "isbn": {
      "minLength": 1,
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "year": {
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    }
  },
  "title": "Book",
  "type": "object"
