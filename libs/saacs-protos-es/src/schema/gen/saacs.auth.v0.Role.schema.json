{
  "$id": "saacs.auth.v0.Role.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Shared Auth Object for Role Based Authentication",
  "patternProperties": {
    "^(collectionId)$": {
      "minLength": 1,
      "type": "string"
    },
    "^(parentRoleIds)$": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "^(roleId)$": {
      "minLength": 1,
      "type": "string"
    }
  },
  "properties": {
    "collection_id": {
      "minLength": 1,
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "parent_role_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "polices": {
      "$ref": "saacs.auth.v0.Polices.schema.json"
    },
    "role_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "polices"
  ],
  "title": "Role",
  "type": "object"
}
